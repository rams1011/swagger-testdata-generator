{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testdata.studio/schemas/collection/v1.json",
  "title": "testdata.studio.collection/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "spec", "plan", "cases"],
  "properties": {
    "format": { "const": "testdata.studio.collection" },
    "version": { "const": 1 },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "baseUrl": { "type": ["string", "null"] }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] }
      }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileId", "fileName", "path"],
      "properties": {
        "fileId": { "type": "string" },
        "fileName": { "type": "string" },
        "contentType": { "type": ["string", "null"] },
        "sizeBytes": { "type": "integer" },
        "path": { "type": "string", "description": "Relative path under collections/<spec>/files" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "testName", "method", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operationKey": { "type": ["string", "null"] },
        "testName": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "description": "OpenAPI raw path, e.g. /api/roles/{id}" },
        "endpoint": { "type": ["string", "null"] },
        "baseUrl": {
          "type": ["string", "null"],
          "description": "{{baseUrl}} unless this case overrides the spec/environment URL"
        },
        "contentType": { "type": ["string", "null"] },
        "pathParams": { "$ref": "#/$defs/stringMap" },
        "queryParams": { "$ref": "#/$defs/stringMap" },
        "headers": { "$ref": "#/$defs/stringMap" },
        "cookies": { "$ref": "#/$defs/stringMap" },
        "body": true,
        "responseJsonSchema": { "type": ["object", "null"] },
        "statusCode": { "type": "integer" },
        "responseType": { "type": ["string", "null"] },
        "expectedResponse": { "type": ["string", "null"] },
        "enabled": { "type": ["string", "null"] },
        "testGroup": { "type": ["string", "null"] },
        "jsonPathAssertions": { "type": ["string", "null"] },
        "extracts": { "type": ["string", "null"] },
        "maxResponseTimeMs": { "type": ["integer", "null"] },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/file" }
        }
      }
    }
  }
}
