# Copy to .env for docker compose (optional overrides).

# Postgres (db service)
POSTGRES_DB=testdata_studio
POSTGRES_USER=testdata
POSTGRES_PASSWORD=testdata
POSTGRES_PORT=5432

# API
API_PORT=8083
TESTDATA_EDITION=local

# Hosted / Cloud Run / datacenter (not used by default compose file)
# SPRING_PROFILES_ACTIVE=cloud
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/testdata_studio?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=
# TESTDATA_EDITION=saas
# TESTDATA_SAAS_ADMIN_EMAIL=
# TESTDATA_SAAS_ADMIN_PASSWORD=
# TESTDATA_SAAS_CORS_ORIGINS=https://studio.example.com
# Production safety (default false) and the SaaS operator console API (default true)
# TESTDATA_SAFETY_ENABLED=true
# TESTDATA_SAAS_OPERATOR_API=false

# Redis spec catalog cache (optional)
# TESTDATA_REDIS_CACHE_ENABLED=true
# TESTDATA_REDIS_HOST=10.0.0.5
# TESTDATA_REDIS_PORT=6378
# TESTDATA_REDIS_PASSWORD=
# TESTDATA_REDIS_SSL=true
# TESTDATA_REDIS_DISABLE_PEER_VERIFICATION=true
# TESTDATA_REDIS_CACHE_TTL_SECONDS=300

# Logs (see docs/LOGGING.md). Unset = readable text on the console.
# TESTDATA_LOG_FORMAT=ecs
# TESTDATA_LOG_ENVIRONMENT=local
# ECS JSON file for the local Elastic stack (docs/examples/elastic), console stays text:
# LOGGING_FILE_NAME=logs/testdata-studio.json
# LOGGING_STRUCTURED_FORMAT_FILE=ecs
