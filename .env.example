# Copy to .env for docker compose (optional overrides).

# Postgres (db service)
POSTGRES_DB=testdata_studio
POSTGRES_USER=testdata
POSTGRES_PASSWORD=testdata
POSTGRES_PORT=5432

# API
API_PORT=8083
TESTDATA_EDITION=local

# Hosted / Cloud Run / datacenter (not used by default compose file)
# SPRING_PROFILES_ACTIVE=cloud
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/testdata_studio?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=
# TESTDATA_EDITION=saas
# TESTDATA_SAAS_ADMIN_EMAIL=
# TESTDATA_SAAS_ADMIN_PASSWORD=
# TESTDATA_SAAS_CORS_ORIGINS=https://studio.example.com
